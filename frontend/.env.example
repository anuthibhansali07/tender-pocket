# ==============================================================================
# Frontend Next.js Environment Variables Template
# Copy this file to .env.local and populate with your own configurations.
# ==============================================================================

# Server Port & Public App URL
PORT=8085
NEXT_PUBLIC_APP_URL=http://localhost:8085

# Spring Boot Backend API URL (Proxied by Next.js API route handlers)
BACKEND_URL=http://localhost:8090

# Shared JWT Secret with Backend (Min 256-bit key for HMAC-SHA256 / HMAC-SHA512)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here

# Local SQLite Database Path (Defaults to ./tenders.db in frontend root)
DATABASE_PATH=./tenders.db

# Seed User Default Passwords (Optional overrides on initial database startup)
ADMIN_DEFAULT_PASSWORD=your_initial_admin_password
EXECUTIVE_DEFAULT_PASSWORD=your_initial_executive_password
CLEARANCE_DEFAULT_PASSWORD=your_initial_clearance_password
TPC_DEFAULT_PASSWORD=your_initial_tpc_password
MISTEAM_DEFAULT_PASSWORD=your_initial_mis_password
SPECTEAM_DEFAULT_PASSWORD=your_initial_spec_password

# Google Gemini AI API Key (Used for document processing & technical specification extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Scraping & Processing Endpoint (Used by background sync scripts)
TENDER_API_URL=http://localhost:8085/api/process-email

# IMAP Email Sync Configuration (Optional - for auto-pulling tender emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
SENDER_FILTER=sales@tender247.com
SUBJECT_FILTER=Tender247

# SMTP Email Alert Configuration (Optional - for sending manager notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MANAGER_EMAIL=manager@company.com
