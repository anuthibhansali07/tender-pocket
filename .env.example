# ==============================================================================
# TenderPocket Environment Variables Template
# Copy this file to .env or .env.local and populate with your own credentials.
# NEVER commit real credentials to source control.
# ==============================================================================

# Server Ports
SPRING_PORT=8090
PORT=8085

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:8085
BACKEND_URL=http://localhost:8090
TENDER_API_URL=http://localhost:8085/api/process-email

# Backend PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tender_pocket?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
DATABASE_URL=jdbc:postgresql://localhost:5432/tender_pocket?sslmode=disable
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Frontend SQLite Database Path (Optional - defaults to ./tenders.db)
DATABASE_PATH=./tenders.db

# Security & JWT Token (generate a secure 256-bit or 512-bit hex key in production)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION=315360000

# Seed User Defaults (Optional overrides for initial user creation)
ADMIN_DEFAULT_PASSWORD=your_initial_admin_password
EXECUTIVE_DEFAULT_PASSWORD=your_initial_executive_password
CLEARANCE_DEFAULT_PASSWORD=your_initial_clearance_password
TPC_DEFAULT_PASSWORD=your_initial_tpc_password
MISTEAM_DEFAULT_PASSWORD=your_initial_mis_password
SPECTEAM_DEFAULT_PASSWORD=your_initial_spec_password

# Email Alerts (Spring Boot SMTP)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# Email Alerts (Frontend / Node.js SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MANAGER_EMAIL=manager@company.com

# IMAP Email Scraping (Auto-sync tenders from emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_USER=your_email@gmail.com
IMAP_SENDER_FILTER=sales@tender247.com
SUBJECT_FILTER=Tender247

# AI Gemini API Key (For technical specification parsing and document summarization)
GEMINI_API_KEY=your_gemini_api_key_here

