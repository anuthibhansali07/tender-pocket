# ==============================================================================
# TenderPocket Environment Variables Template
# Copy this file to .env or .env.local and populate with your own credentials.
# NEVER commit real credentials to source control.
# ==============================================================================

# Server Ports
SPRING_PORT=8090
PORT=8085

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:8085
BACKEND_URL=http://localhost:8090
TENDER_API_URL=http://localhost:8085/api/process-email

# Backend PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tender_pocket?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
DATABASE_URL=jdbc:postgresql://localhost:5432/tender_pocket?sslmode=disable
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Frontend SQLite Database Path (Optional - defaults to ./tenders.db)
DATABASE_PATH=./tenders.db

# Security & JWT Token (generate a secure 256-bit or 512-bit hex key in production)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION=315360000

# Seed User Defaults (Optional overrides for initial user creation)
ADMIN_DEFAULT_PASSWORD=your_initial_admin_password
EXECUTIVE_DEFAULT_PASSWORD=your_initial_executive_password
CLEARANCE_DEFAULT_PASSWORD=your_initial_clearance_password
TPC_DEFAULT_PASSWORD=your_initial_tpc_password
MISTEAM_DEFAULT_PASSWORD=your_initial_mis_password
SPECTEAM_DEFAULT_PASSWORD=your_initial_spec_password

# Email Alerts (Spring Boot SMTP)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# Email Alerts (Frontend / Node.js SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MANAGER_EMAIL=manager@company.com

# Daily tender mails (Due + Pending, sent by the backend every day at 9:00 IST)
# Each login gets at most two mails a day: tenders due in the next 3 days, and work
# waiting on that login for more than 3 days. Lists longer than NOTIFY_MAX_ROWS (or too
# big for Gmail) get an Excel file with every row attached. Nothing is sent until
# NOTIFY_ENABLED=true. No cron job is needed: the backend runs it on NOTIFY_CRON.
NOTIFY_ENABLED=false
# Sender account. Gmail needs a 16-letter App Password (Google Account > Security >
# App passwords), not the normal password. Left empty, SPRING_MAIL_USERNAME and
# SPRING_MAIL_PASSWORD are used.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USERNAME=your_sender@gmail.com
NOTIFY_SMTP_PASSWORD=your_gmail_app_password
NOTIFY_MAIL_FROM_NAME=TenderPocket Alerts
# Receiver address for each login, as login=email pairs separated by commas (one line).
# A login left out here gets mail at the email saved for it in TenderPocket (users table).
NOTIFY_RECIPIENTS=admin=admin@company.com,MIS1=mis1@company.com,MIS2=mis2@company.com,MIS3=mis3@company.com,MIS_COMMON=mis.common@company.com,TPC=tpc@company.com,CLEARANCE_1=clearance1@company.com,CLEARANCE_2=clearance2@company.com,EXECUTIVE_1=executive1@company.com,EXECUTIVE_2=executive2@company.com,EXECUTIVE_3=executive3@company.com,EXECUTIVE_4=executive4@company.com,EXECUTIVE_5=executive5@company.com,EXECUTIVE_6=executive6@company.com,EXECUTIVE_7=executive7@company.com,EXECUTIVE_8=executive8@company.com,EXECUTIVE_9=executive9@company.com,EXECUTIVE_10=executive10@company.com
# Schedule (Spring cron, seconds first, Asia/Kolkata time) and rules.
NOTIFY_CRON=0 0 9 * * *
NOTIFY_PENDING_DAYS=3
NOTIFY_DUE_WINDOW_DAYS=3
NOTIFY_MAX_ROWS=200
# Live app address: each tender in the mails links to <url>/tenders/<id>.
NOTIFY_APP_URL=http://13.232.232.54:8085

# IMAP Email Scraping (Auto-sync tenders from emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_USER=your_email@gmail.com
IMAP_SENDER_FILTER=sales@tender247.com
SUBJECT_FILTER=Tender247

# AI Gemini API Key (For technical specification parsing and document summarization)
GEMINI_API_KEY=your_gemini_api_key_here

