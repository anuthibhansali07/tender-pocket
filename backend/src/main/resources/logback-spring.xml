<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot's default logging (same patterns, levels and rolling file from logging.* properties),
  except the console appender writes to the real console saved by StdoutLogBridge. With Logback's
  own ConsoleAppender every logger line would come back through the bridged System.out and be
  logged twice.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}}/spring.log}"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <appender name="CONSOLE" class="com.tenderpocket.config.OriginalConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
